rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && callerProfile().role == role;
    }

    function isCoordinator() {
      return hasRole('coordinator');
    }

    function isStudent() {
      return hasRole('student') && callerProfile().requestedRole == 'student';
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isDocumentId(value) {
      return value is string && value.matches('[^/]{1,128}') && !(value in ['.', '..']);
    }

    function classIsActiveAfterWrite(classId) {
      return getAfter(/databases/$(database)/documents/classes/$(classId)).data.isArchived == false;
    }

    function membershipData(classId) {
      let membershipId = classId + '_' + request.auth.uid;
      return get(/databases/$(database)/documents/memberships/$(membershipId)).data;
    }

    function isActiveMember(classId) {
      let membership = membershipData(classId);
      return membership.classId == classId && membership.studentId == request.auth.uid
        && membership.isActive == true;
    }

    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validText(value, minimum, maximum) {
      return value is string && value.trim().size() >= minimum && value.size() <= maximum;
    }

    function validAttendancePolicy(data) {
      return data.gracePeriodMinutes is int && data.gracePeriodMinutes >= 0
        && data.gracePeriodMinutes <= 9007199254740991
        && data.fineAmount is int && data.fineAmount > 0 && data.fineAmount <= 9007199254740991;
    }

    match /deviceTokens/{tokenId} {
      allow read, write: if false;
    }

    match /deviceTokenLocks/{lockId} {
      allow read, write: if false;
    }

    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    match /fines/{fineId} {
      allow get, list: if isCoordinator()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (hasRole('assistant') && classData(resource.data.classId).assistantId == request.auth.uid);
      allow write: if false;
    }

    match /paymentTransactions/{orderId} {
      allow get, list: if isCoordinator() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /laboratories/{labId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isCoordinator();
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isInitialProfile() {
        let profile = request.resource.data;
        let fields = ['uid', 'email', 'name', 'studentNumber', 'role', 'requestedRole', 'createdAt', 'updatedAt'];
        return hasExactFields(profile, fields)
          && profile.uid == uid
          && profile.email is string && profile.email == request.auth.token.email
          && profile.name is string && profile.name.trim().size() > 0
          && profile.role == 'student'
          && (
            (profile.requestedRole == 'student'
              && profile.studentNumber is string && profile.studentNumber.trim().size() > 0)
            || (profile.requestedRole == 'assistant'
              && (profile.studentNumber == null || (profile.studentNumber is string && profile.studentNumber.trim().size() > 0)))
          )
          && profile.createdAt == request.time && profile.updatedAt == request.time;
      }

      // The enrolment form looks up a registered practicum student by UID.
      allow get: if isOwner() || isCoordinator() || (hasRole('assistant')
        && resource.data.role == 'student' && resource.data.requestedRole == 'student');
      allow list: if isCoordinator() || hasRole('assistant');
      allow create: if isOwner() && isInitialProfile();
      allow update: if isCoordinator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'requestedRole', 'updatedAt'])
        && request.resource.data.role in ['student', 'assistant']
        && request.resource.data.requestedRole in ['student', 'assistant']
        && request.resource.data.updatedAt == request.time;
    }

    match /classes/{classId} {
      function validClassDetails(data) {
        return validText(data.name, 1, 200) && validText(data.code, 1, 64)
          && validText(data.course, 1, 200) && validText(data.timeZone, 1, 100);
      }

      function canCreateClass(data) {
        let fields = ['name', 'code', 'course', 'timeZone', 'assistantId', 'isArchived', 'createdAt', 'updatedAt'];
        return (isCoordinator() && hasExactFields(data, fields.concat(['gracePeriodMinutes', 'fineAmount']))
            && validAttendancePolicy(data))
          || (hasRole('assistant') && data.assistantId == request.auth.uid && hasExactFields(data, fields));
      }

      function canUpdateClass(data) {
        let changed = data.diff(resource.data).affectedKeys();
        let fields = ['name', 'code', 'course', 'timeZone', 'assistantId', 'isArchived', 'updatedAt'];
        let policyFields = ['gracePeriodMinutes', 'fineAmount'];
        return (isCoordinator() && changed.hasOnly(fields.concat(policyFields))
            && (!changed.hasAny(policyFields) || validAttendancePolicy(data)))
          || (hasRole('assistant') && resource.data.assistantId == request.auth.uid
            && data.assistantId == request.auth.uid && changed.hasOnly(fields));
      }

      allow get: if isCoordinator()
        || (hasRole('assistant') && resource.data.assistantId == request.auth.uid)
        || (isStudent() && isActiveMember(classId));
      allow list: if isCoordinator()
        || (hasRole('assistant') && resource.data.assistantId == request.auth.uid);
      allow create: if canCreateClass(request.resource.data)
        && request.resource.data.isArchived == false
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && validClassDetails(request.resource.data);
      allow update: if canUpdateClass(request.resource.data)
        && resource.data.isArchived == false && request.resource.data.isArchived is bool
        && request.resource.data.updatedAt == request.time && validClassDetails(request.resource.data);
    }

    match /memberships/{membershipId} {
      function ownsMembershipClass() {
        return hasRole('assistant') && classData(resource.data.classId).assistantId == request.auth.uid;
      }

      function canReadMembership() {
        // The assistant roster query constrains classId, so check the canonical class owner.
        return isCoordinator() || (isStudent() && resource.data.studentId == request.auth.uid)
          || ownsMembershipClass();
      }

      function matchesStudentProfile(data) {
        let profile = get(/databases/$(database)/documents/users/$(data.studentId)).data;
        return profile.uid == data.studentId
          && profile.role == 'student' && profile.requestedRole == 'student'
          && profile.name is string && profile.name.trim().size() > 0
          && profile.studentNumber is string && profile.studentNumber.trim().size() > 0
          && data.studentName == profile.name && data.studentNumber == profile.studentNumber;
      }

      function validMembershipWrite(data) {
        let fields = ['classId', 'studentId', 'assistantId', 'studentName',
          'studentNumber', 'isActive', 'createdAt', 'updatedAt'];
        return hasExactFields(data, fields)
          && isDocumentId(data.classId) && isDocumentId(data.studentId)
          && membershipId == data.classId + '_' + data.studentId
          && isDocumentId(data.assistantId)
          && getAfter(/databases/$(database)/documents/classes/$(data.classId)).data.assistantId == data.assistantId
          && classIsActiveAfterWrite(data.classId)
          && data.isActive is bool && data.createdAt is timestamp && data.updatedAt == request.time
          && matchesStudentProfile(data);
      }

      allow get, list: if canReadMembership();
      allow create: if isCoordinator() && validMembershipWrite(request.resource.data)
        && request.resource.data.isActive == true && request.resource.data.createdAt == request.time;
      allow update: if isCoordinator() && validMembershipWrite(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assistantId', 'isActive', 'studentName', 'studentNumber', 'updatedAt']);
    }

    match /sessions/{sessionId} {
      function matchesClassAttendancePolicy(data) {
        let course = getAfter(/databases/$(database)/documents/classes/$(data.classId)).data;
        return course.assistantId == request.auth.uid && course.isArchived == false
          && validAttendancePolicy(data)
          && data.gracePeriodMinutes == course.gracePeriodMinutes && data.fineAmount == course.fineAmount;
      }

      function validSessionDetails(data) {
        return validText(data.title, 1, 200) && validText(data.room, 1, 200)
          && validText(data.timeZone, 1, 100)
          && data.startsAt is timestamp && data.endsAt is timestamp && data.startsAt < data.endsAt;
      }

      function isSessionOwner() {
        return hasRole('assistant') && resource.data.assistantId == request.auth.uid
          && classData(resource.data.classId).assistantId == request.auth.uid;
      }

      function validSessionUpdate() {
        let next = request.resource.data;
        let previous = resource.data;
        let changed = next.diff(previous).affectedKeys();
        return next.updatedAt == request.time && (
          (previous.isArchived == false && previous.status == 'open' && next.status == 'closed'
            && next.closedAt == request.time && changed.hasOnly(['status', 'closedAt', 'updatedAt']))
          || (previous.isArchived == false && previous.status == 'not_open'
            && classIsActiveAfterWrite(previous.classId)
            && next.isArchived == true && changed.hasOnly(['isArchived', 'updatedAt']))
        );
      }

      allow get: if isCoordinator() || isSessionOwner() || (isStudent() && (
        isActiveMember(resource.data.classId)
        || exists(/databases/$(database)/documents/sessions/$(sessionId)/participations/$(request.auth.uid))
      ));
      // Existing client-side room conflict checks query active sessions across classes.
      allow list: if isCoordinator()
        || (hasRole('assistant') && (resource.data.isArchived == false
          || classData(resource.data.classId).assistantId == request.auth.uid))
        || (isStudent() && isActiveMember(resource.data.classId));
      allow create: if hasRole('assistant')
        && hasExactFields(request.resource.data, ['classId', 'assistantId', 'title', 'room', 'startsAt',
          'endsAt', 'timeZone', 'gracePeriodMinutes', 'fineAmount', 'status', 'isArchived',
          'openedAt', 'closedAt', 'createdAt', 'updatedAt'])
        && isDocumentId(request.resource.data.classId)
        && request.resource.data.assistantId == request.auth.uid
        && matchesClassAttendancePolicy(request.resource.data)
        && request.resource.data.status == 'not_open' && request.resource.data.isArchived == false
        && request.resource.data.openedAt == null && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && validSessionDetails(request.resource.data);
      allow update: if isSessionOwner() && validSessionUpdate();

      match /participations/{studentId} {
        function parentSession() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }

        function ownsParentClass() {
          return hasRole('assistant') && classData(parentSession().classId).assistantId == request.auth.uid;
        }

        function isInitialAi(ai) {
          return ai == {
            'status': 'pending', 'category': null, 'confidence': null, 'modelVersion': null,
            'classifiedAt': null, 'errorCode': null, 'requestId': null, 'startedAt': null, 'attemptCount': 0
          } && ai.attemptCount is int;
        }

        function validParticipation(data) {
          let session = parentSession();
          let course = classData(session.classId);
          let membership = membershipData(session.classId);
          let fields = ['sessionId', 'classId', 'assistantId', 'studentId', 'studentName',
            'studentNumber', 'kind', 'createdAt', 'updatedAt', 'reason', 'status',
            'reviewedBy', 'reviewedAt', 'reviewNote', 'ai'];
          return data.studentId == studentId && data.sessionId == sessionId && data.classId == session.classId
            && data.assistantId == session.assistantId && session.assistantId == course.assistantId
            && membership.classId == session.classId && membership.studentId == studentId
            && membership.assistantId == course.assistantId && membership.isActive == true
            && data.studentName == membership.studentName && data.studentNumber == membership.studentNumber
            && data.createdAt == request.time && data.updatedAt == request.time
            && session.isArchived == false && course.isArchived == false
            && data.kind == 'leave' && session.status in ['not_open', 'open']
            && hasExactFields(data, fields)
            && validText(data.reason, 10, 1000) && data.reason == data.reason.trim()
            && data.status == 'pending' && data.reviewedBy == null && data.reviewedAt == null
            && data.reviewNote == null && isInitialAi(data.ai);
        }

        allow get: if (isStudent() && request.auth.uid == studentId) || ownsParentClass();
        allow list: if ownsParentClass();
        allow create: if isStudent() && request.auth.uid == studentId && validParticipation(request.resource.data);
      }
    }

    match /{path=**}/participations/{participationId} {
      // These fields are fixed at creation and protected from client updates.
      allow list: if (isStudent() && resource.data.studentId == request.auth.uid)
        || (hasRole('assistant') && resource.data.assistantId == request.auth.uid && resource.data.kind == 'leave');
    }
  }
}
